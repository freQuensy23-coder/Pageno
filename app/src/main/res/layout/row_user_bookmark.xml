<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageButton
        android:id="@+id/userBookmarkDragHandle"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/drag_to_reorder"
        android:src="@drawable/ic_burger_menu"
        android:tint="?attr/colorOnSurfaceVariant"
        tools:ignore="UseAppTint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/userBookmarkTopRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/userBookmarkTopPage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="Page 42" />

            <TextView
                android:id="@+id/userBookmarkTopTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="3 days ago" />
        </LinearLayout>

        <TextView
            android:id="@+id/userBookmarkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            tools:text="Part 2 ▶ Chapter 5 ▶ Memory model" />

        <TextView
            android:id="@+id/userBookmarkSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="Page 42 · 2 days ago" />

        <TextView
            android:id="@+id/userBookmarkPageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Page 42 · 2 days ago"
            tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/userBookmarkRename"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/rename_bookmark"
        android:src="@drawable/ic_edit"
        android:tint="?attr/colorOnSurfaceVariant"
        tools:ignore="UseAppTint" />

    <ImageButton
        android:id="@+id/userBookmarkDelete"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete"
        android:src="@drawable/ic_delete"
        android:tint="?attr/colorOnSurfaceVariant"
        tools:ignore="UseAppTint" />
</LinearLayout>
