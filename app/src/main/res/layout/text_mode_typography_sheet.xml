<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_mode_appearance"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetSettingsButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/text_size" />

        <com.google.android.material.slider.Slider
            android:id="@+id/fontSizeSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="1"
            android:valueFrom="12"
            android:valueTo="36" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_mode_line_spacing" />

        <com.google.android.material.slider.Slider
            android:id="@+id/lineSpacingSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="0.05"
            android:valueFrom="1"
            android:valueTo="2.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/text_mode_margins" />

        <com.google.android.material.slider.Slider
            android:id="@+id/marginSlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stepSize="2"
            android:valueFrom="8"
            android:valueTo="48" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_mode_readable_line_length" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/readableLineLengthSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_mode_join_paragraphs" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/joinParagraphsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_mode_detect_headings" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/detectHeadingsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/text_mode_code_blocks" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/codeBlocksSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/text_mode_theme" />

        <GridLayout
            android:id="@+id/themeGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/systemThemeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/system" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lightThemeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sepiaThemeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/sepia" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/darkThemeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/dark" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/blackThemeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/black" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/draculaThemeButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/dracula" />
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/text_mode_font" />

        <GridLayout
            android:id="@+id/fontGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sansFontButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/text_mode_font_sans" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/serifFontButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/text_mode_font_serif" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/monoFontButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_gravity="fill_horizontal"
                android:layout_margin="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:minWidth="0dp"
                android:text="@string/text_mode_font_mono" />
        </GridLayout>
    </LinearLayout>
</ScrollView>
