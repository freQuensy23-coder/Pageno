<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp">

        <com.gitlab.mudlej.MjPdfReader.ui.reader.annotation.SignatureView
            android:id="@+id/signatureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/signatureColorBlackButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/signature_color_black"
            android:focusable="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/signatureColorBlackSwatch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#1A1A1A"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/signatureColorBlueButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/signature_color_blue"
            android:focusable="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/signatureColorBlueSwatch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#1E4FC2"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/signatureColorRedButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/signature_color_red"
            android:focusable="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/signatureColorRedSwatch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#C62828"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/signatureColorGreenButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/signature_color_green"
            android:focusable="true">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/signatureColorGreenSwatch"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="#2E7D32"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutline"
                app:strokeWidth="1dp" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
