<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="app-db.db" />
        <include domain="database" path="app-db.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="app-db.db" />
        <include domain="database" path="app-db.db-wal" />
        <include domain="file" path="annotations" />
        <include domain="file" path="signature" />
    </device-transfer>
</data-extraction-rules>
